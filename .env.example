# ==============================================================================
# Jev-Chromium 环境变量配置示例 (Environment Variables Template)
# 复制此文件为 .env 并填入实际 API Key
# cp .env.example .env
# ==============================================================================

# 1. TypeSafe Jev 核心视觉决策模型 (必需)
# 申请或获取地址: https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-latest

# 2. 辅助文本生成大模型 (用于复杂输入框文本推断与填充，兼容 OpenAI 规范)
# 预设推荐: MiniMax (https://api.minimaxi.com/v1), DeepSeek, OpenAI
TEXT_MODEL_API_KEY=your_text_model_api_key_here
TEXT_MODEL_BASE_URL=https://api.minimaxi.com/v1
TEXT_MODEL=MiniMax-M3
TEXT_MODEL_REASONING=none
